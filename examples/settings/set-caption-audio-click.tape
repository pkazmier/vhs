Output examples/settings/set-caption-audio-click.mp4
Set Width 800
Set Height 225
Set Padding 30

Set FontSize 18
#Set TypingSpeed 0.1
Set Theme "Catppuccin Macchiato"

Set CaptionAudio "click"
Set CaptionAudioVolume 1
Set CaptionBoxColor "#777777"

CaptionOn

Type "Do you hear what I hear? Clicking?"
Sleep 2s
